 	tools/cephfs/JournalTool.h \
 	tools/cephfs/JournalScanner.h \
diff --git a/src/tools/ceph_ectool.cc b/src/tools/ceph_ectool.cc
new file mode 100644
index 0000000..04b3894
--- /dev/null
+++ b/src/tools/ceph_ectool.cc
@@ -0,0 +1,247 @@
+/*
